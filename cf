import java.util.*;

class Book {
    int id;
    String name;
    String author;
    boolean available;

    Book(int id, String name, String author) {
        this.id = id;
        this.name = name;
        this.author = author;
        this.available = true;
    }

    void display() {
        System.out.println(id + "  " + name + "  "
                + author + "  "
                + (available ? "Available" : "Issued"));
    }
}

class Library {

    // List to store books
    List<Book> books = new ArrayList<>();

    // Set to maintain unique book IDs
    Set<Integer> bookIds = new HashSet<>();

    // Map to search books using ID
    Map<Integer, Book> bookMap = new HashMap<>();

    // Queue to maintain waiting students
    Queue<String> waitingList = new LinkedList<>();

    // Add book
    void addBook(int id, String name, String author) {

        if (bookIds.add(id)) {
            Book b = new Book(id, name, author);

            books.add(b);
            bookMap.put(id, b);

            System.out.println("Book added successfully!");
        } else {
            System.out.println("Book ID already exists!");
        }
    }

    // Display all books
    void displayBooks() {

        System.out.println("\n--- Book List ---");

        for (Book b : books) {
            b.display();
        }
    }

    // Search book
    void searchBook(int id) {

        Book b = bookMap.get(id);

        if (b != null) {
            b.display();
        } else {
            System.out.println("Book not found!");
        }
    }

    // Issue book
    void issueBook(int id, String student) {

        Book b = bookMap.get(id);

        if (b == null) {
            System.out.println("Invalid Book ID!");
        } else if (b.available) {

            b.available = false;
            System.out.println("Book issued to " + student);

        } else {

            waitingList.offer(student);
            System.out.println("Book unavailable!");
            System.out.println(student + " added to waiting list.");
        }
    }

    // Return book
    void returnBook(int id) {

        Book b = bookMap.get(id);

        if (b == null) {
            System.out.println("Invalid Book ID!");
        } else if (b.available) {
            System.out.println("Book was not issued!");
        } else {

            b.available = true;
            System.out.println("Book returned successfully!");

            if (!waitingList.isEmpty()) {

                String student = waitingList.poll();

                b.available = false;

                System.out.println("Book issued to waiting student: "
                        + student);
            }
        }
    }
}

// Main class
public class LibraryManagement {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        Library lib = new Library();

        while (true) {

            System.out.println("\n===== LIBRARY MANAGEMENT =====");
            System.out.println("1. Add Book");
            System.out.println("2. Display Books");
            System.out.println("3. Search Book");
            System.out.println("4. Issue Book");
            System.out.println("5. Return Book");
            System.out.println("6. Exit");

            System.out.print("Enter choice: ");
            int choice = sc.nextInt();

            switch (choice) {

                case 1:
                    System.out.print("Enter Book ID: ");
                    int id = sc.nextInt();

                    sc.nextLine();

                    System.out.print("Enter Book Name: ");
                    String name = sc.nextLine();

                    System.out.print("Enter Author: ");
                    String author = sc.nextLine();

                    lib.addBook(id, name, author);
                    break;

                case 2:
                    lib.displayBooks();
                    break;

                case 3:
                    System.out.print("Enter Book ID: ");
                    lib.searchBook(sc.nextInt());
                    break;

                case 4:
                    System.out.print("Enter Book ID: ");
                    int issueId = sc.nextInt();

                    sc.nextLine();

                    System.out.print("Enter Student Name: ");
                    String student = sc.nextLine();

                    lib.issueBook(issueId, student);
                    break;

                case 5:
                    System.out.print("Enter Book ID: ");
                    lib.returnBook(sc.nextInt());
                    break;

                case 6:
                    System.out.println("Thank You!");
                    sc.close();
                    return;

                default:
                    System.out.println("Invalid Choice!");
            }
        }
    }
}
